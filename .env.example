# Copy this file to `.env` and fill in your key.
# Get a key at https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=

# Supabase URL and Publishable Key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: model override (default: gemini-3.5-flash-lite)
# EXPO_PUBLIC_GEMINI_MODEL=gemini-flash-latest

# Optional: thinking level — MINIMAL, LOW, MEDIUM or HIGH
# Defaults to MINIMAL for *-lite models and LOW for other models.
# EXPO_PUBLIC_GEMINI_THINKING_LEVEL=MINIMAL
